# ==============================================================================
# 技术边界数据库 — 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 Git 忽略。
# ==============================================================================

# 运行环境。生产环境会拒绝缺失的安全配置。
TECHDB_ENV=production

# 认证签名密钥。生成方式：openssl rand -hex 32
SECRET_KEY=replace_with_a_random_64_hex_string

# PostgreSQL。使用随机强密码，不要使用示例值部署。
POSTGRES_DB=tech_intel
POSTGRES_USER=techdb
POSTGRES_PASSWORD=replace_with_a_strong_database_password
# 为兼容既有部署沿用旧卷名；升级 0801 时不要无故改名，否则会挂载到空数据库。
TECHDB_PG_VOLUME=v260723_pg_data

# 首次启动时只创建一个管理员；已有同名账号时不覆盖。
TECHDB_INITIAL_ADMIN_USERNAME=admin
TECHDB_INITIAL_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# ------------------------------------------------------------------------------
# AI 模型配置
# ------------------------------------------------------------------------------
# [必填] 公司 AI 网关 API Key；不要把真实密钥提交到仓库。
TECHDB_AGENT_API_KEY=replace_with_company_gateway_api_key

# 公司内网 AI 网关（OpenAI chat/completions 兼容）
TECHDB_AGENT_BASE_URL=https://aigate.catl.com/v1

# 默认模型名称（CATL AI 网关）
TECHDB_AGENT_MODEL=GLM-5.2

# 前端可选模型列表，逗号分隔；默认模型会自动包含在列表中
# CATL AI 网关可选模型：GLM-5.2 / GLM-5.1 / Kimi-K2.6 / DeepSeek-V4-Pro / MiniMax-M2.7 等
TECHDB_AGENT_ALLOWED_MODELS=GLM-5.2,GLM-5.1,Kimi-K2.6,DeepSeek-V4-Pro,MiniMax-M2.7

# AI 请求超时（秒）
TECHDB_AGENT_AI_TIMEOUT_SECONDS=180

# 上游 429 / rate-limit 短退避重试次数（默认 2 次）
TECHDB_AGENT_MAX_RETRIES=2

# 重试基础等待秒数；第 n 次等待 base*n 秒（默认 2、4 秒）
TECHDB_AGENT_RETRY_BASE_DELAY_SECONDS=2

# 每轮最多注入最近 60 条消息，并设置 60000 字符的总预算；后续阶段将升级为滚动摘要。
TECHDB_AGENT_HISTORY_MAX_MESSAGES=60
TECHDB_AGENT_HISTORY_MAX_CHARS=60000

# 单轮检索材料字符预算；历史对话另计。
TECHDB_AGENT_RETRIEVAL_MAX_CHARS=30000

# 默认回答保持紧凑；用户明确要求长报告时，后续可按请求类型动态调整。
TECHDB_AGENT_MAX_OUTPUT_TOKENS=10000

# ------------------------------------------------------------------------------
# GitHub canonical 问答检索服务
# ------------------------------------------------------------------------------
# 本仓库自包含的 canonical-qa：已迁入原 TechDB 的 hybrid retrieval、
# evidence/citation/verification 能力。与门户共同部署在服务器 Docker 网络，
# 运行时不依赖 sbq9712/tech-db 仓库。
TECHDB_QA_SERVICE_URL=http://canonical-qa:8765
# CPU 首次加载 bge-m3 可能需要约 50 秒；应覆盖检索服务冷启动。
TECHDB_QA_SERVICE_TIMEOUT_SECONDS=120

# 上传资料写入增量索引的最长等待时间。首次加载 bge-m3 时可能较慢。
TECHDB_QA_INDEX_TIMEOUT_SECONDS=300

# API 与 canonical-qa 之间的内部写入令牌；生产环境必须设置随机强值。
# 生成方式：openssl rand -hex 32（api 与 canonical-qa 两侧必须同值）
# ⚠️ 未配置或保留占位符时，canonical-qa 全部写端点（/api/index/upsert、
#    /api/index/delete、/api/index/record-mutate）将返回 503 拒绝写入，
#    广度问答增量索引随之停止更新——这是刻意的安全闸门（T8，2026-10-02）。
# 同步脚本侧令牌另需写入 runtime/qa-index-sync/token（0600），见
# scripts/sync_qa_index.py 文档与 DEPLOY.md。
TECHDB_QA_INDEX_TOKEN=replace_with_a_random_internal_index_token

# canonical-qa 自身 chat/graph-ingest 生成侧需要 ZAI key（广度页问答视图已下线，
# 保留的 /api/breadth/qa/* 代理仍走此链路）（qa-backend/config.py 优先读该 env，缺省回落
# 宿主 ~/.config/anthropic-proxy.env）。缺省留空 = 问答视图只有检索无生成。
# TECHDB_QA_LLM_API_KEY=

# 上传资料的增量向量/BM25 索引保存在 Docker 卷中，独立于只读基线索引。
TECHDB_QA_INCREMENTAL_VOLUME=techdb_qa_incremental_0801

# canonical-qa 集成镜像已经内置并校验模型、基线索引、记录与图谱资产；
# 公司离线服务器启动不重建基线 embedding，也不从 Hugging Face 下载模型。
# 新上传资料只更新独立增量索引；需要全量重建时在有算力的构建环境完成后再交付镜像。

# ------------------------------------------------------------------------------
# 服务端口与绑定
# ------------------------------------------------------------------------------
# 前端端口（默认 8080）
TECHDB_WEB_PORT=8080
# API/Agent 默认只绑定回环地址；如需外部访问请配置网关代理
TECHDB_API_BIND=127.0.0.1
TECHDB_AGENT_BIND=127.0.0.1
# canonical QA 诊断端口只绑定服务器回环地址；门户通过 Docker 网络访问。
TECHDB_QA_BIND=127.0.0.1
# 宿主端口：容器内 8765，默认映射到宿主 8767（旧 tech-db 栈占用 8765，
# compose 默认值即 8767——与 docker-compose.yml 端口段一致）。
TECHDB_QA_PORT=8767
# 8766 预留给 readonly-agent 默认映射。
TECHDB_AGENT_PORT=8766
TECHDB_DOCKER_MTU=1410

# 已导入已验收镜像时保持 false；仅在明确需要从源码重建 api/agent/web 时改为 true。
TECHDB_FORCE_BUILD=false

# 每个服务独立版本。1001 是完成 QA 迁移、Feed/上传闭环后的集成基线。
# 回滚时可单独改回上一已验收 tag，不要再使用废弃的 TECHDB_IMAGE_TAG。
TECHDB_QA_IMAGE_TAG=1001
TECHDB_API_IMAGE_TAG=1001
TECHDB_AGENT_IMAGE_TAG=1001
TECHDB_WEB_IMAGE_TAG=1001

# ------------------------------------------------------------------------------
# 数据路径配置（可选）
# ------------------------------------------------------------------------------
# 默认使用包内 external-data/ 目录。
# 如果数据放在其他位置，在此指定绝对路径。

# 旧知识库路径（供深度研究/只读工具使用，不参与 0801 门户问答检索）
# TECHDB_KB_PATH=/path/to/knowledge-base

# 交付视图路径
# TECHDB_DELIVERY_VIEWS_PATH=/path/to/delivery-views

# 旧 Chatbot 集成包路径（不参与 0801 门户问答检索）
# TECHDB_CHATBOT_PACKAGE_PATH=/path/to/chatbot-package

# ------------------------------------------------------------------------------
# 文件上传（可选）
# ------------------------------------------------------------------------------
# 宿主机持久目录，Compose 将其挂载到容器固定路径 /app/uploads。
# 本地默认 ./uploads；生产服务器建议使用独立数据盘上的绝对路径。
# TECHDB_UPLOAD_HOST_PATH=/srv/techdb/data/uploads

# API 启动时会补齐旧记录校验和、检查待分类对象并恢复中断任务。
TECHDB_UPLOAD_RECOVERY_ENABLED=true

# 上传摄取全局并发上限（同时处理的文件数；防止压垮 canonical-qa；0=不限）
# 注意：这是单进程内的 threading 信号量——仅约束单个 api 容器内部的并发；
# 若横向扩容多个 api 容器，需另行引入跨进程锁（当前部署形态为单 api 容器）。
# TECHDB_INGEST_MAX_CONCURRENCY=2
