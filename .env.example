# ==============================================================================
# 技术边界数据库 - 环境变量配置
# ==============================================================================
# 部署步骤：
#   1. 编辑本文件，填写 TECHDB_AGENT_API_KEY（唯一必填项）
#   2. 运行 ./deploy.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# AI 模型配置（必填）
# ------------------------------------------------------------------------------
# [必填] API Key
TECHDB_AGENT_API_KEY=your_api_key_here

# API 端点（默认 Z.AI coding endpoint）
TECHDB_AGENT_BASE_URL=https://api.z.ai/api/coding/paas/v4

# 默认模型名称
TECHDB_AGENT_MODEL=glm-5.2

# 前端可选模型列表，逗号分隔；默认模型会自动包含在列表中
TECHDB_AGENT_ALLOWED_MODELS=glm-5.2,glm-5.1,glm-4.5-flash

# AI 请求超时（秒）
TECHDB_AGENT_AI_TIMEOUT_SECONDS=90

# 上游 429 / rate-limit 短退避重试次数（默认 2 次）
TECHDB_AGENT_MAX_RETRIES=2

# 重试基础等待秒数；第 n 次等待 base*n 秒（默认 2、4 秒）
TECHDB_AGENT_RETRY_BASE_DELAY_SECONDS=2

# 每轮最多注入最近 60 条消息，并设置 60000 字符的总预算；后续阶段将升级为滚动摘要。
TECHDB_AGENT_HISTORY_MAX_MESSAGES=60
TECHDB_AGENT_HISTORY_MAX_CHARS=60000

# 单轮检索材料字符预算；历史对话另计。
TECHDB_AGENT_RETRIEVAL_MAX_CHARS=12000

# 默认回答保持紧凑；用户明确要求长报告时，后续可按请求类型动态调整。
TECHDB_AGENT_MAX_OUTPUT_TOKENS=1800

# ------------------------------------------------------------------------------
# 数据路径配置（可选）
# ------------------------------------------------------------------------------
# 默认使用包内 external-data/ 目录。
# 如果数据放在其他位置，在此指定绝对路径。

# 知识库路径
# TECHDB_KB_PATH=/path/to/knowledge-base

# 交付视图路径
# TECHDB_DELIVERY_VIEWS_PATH=/path/to/delivery-views

# Chatbot 集成包路径
# TECHDB_CHATBOT_PACKAGE_PATH=/path/to/chatbot-package

# ------------------------------------------------------------------------------
# 可选配置
# ------------------------------------------------------------------------------
# 前端端口（默认 8080）
# TECHDB_WEB_PORT=8080

# PostgreSQL 数据卷名称（默认 v2606290_pg_data）
# TECHDB_PG_VOLUME=v2606290_pg_data
