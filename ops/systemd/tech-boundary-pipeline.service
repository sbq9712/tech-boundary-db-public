[Unit]
Description=Tech Boundary breadth pipeline (independent of tech-db)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/tech-boundary-db/pipeline.env
ExecStart=/bin/bash -c 'exec /bin/bash "$BOUNDARY_REPO/scripts/run_breadth_pipeline.sh"'
TimeoutStartSec=4h
