   149	def _fsync_directory(path: Path) -> None:
   150	    if not hasattr(os, "O_DIRECTORY"):
   151	        return
   152	    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
   153	    try:
   154	        os.fsync(fd)
   155	    finally:
   156	        os.close(fd)
