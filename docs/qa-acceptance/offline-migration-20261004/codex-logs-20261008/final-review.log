   159	async def persist_upload(upload: UploadFile, allowed_suffixes: frozenset[str] | set[str] | None = None) -> StoredUpload:
   160	    """落盘上传文件并计算校验和。
   161	
   162	    allowed_suffixes 为空时按 Docling 格式注册表校验；给定白名单时按白名单校验
   163	    （GitHub 增量包 .zip 不在 Docling 注册表内，由导入通道单独把关）。
   164	    """
   165	    filename = upload.filename or "unnamed"
   166	    if allowed_suffixes:
   167	        suffix = (Path(filename).suffix or "").lower()
   168	        if (not filename or "/" in filename or "\\" in filename or "\x00" in filename
   169	                or suffix not in allowed_suffixes):
   170	            raise UploadValidationError(
   171	                f"不支持的文件类型：{filename}（仅接受 {'/'.join(sorted(allowed_suffixes))}）",
   172	                status_code=415,
   173	            )
   174	        ext = suffix
   175	    else:
   176	        ext = validate_filename(filename, upload.content_type)
   177	    root = upload_root()
   178	    incoming = root / ".incoming"
   179	    incoming.mkdir(parents=True, exist_ok=True)
   180	
   181	    object_id = uuid.uuid4().hex
   182	    target_dir = root / "objects" / object_id[:2]
   183	    target_dir.mkdir(parents=True, exist_ok=True)
   184	    target = target_dir / f"{object_id}{ext}"
   185	    temp = incoming / f"{object_id}.part"
   186	
   187	    digest = hashlib.sha256()
   188	    size = 0
   189	    try:
   190	        with open(temp, "xb") as handle:
   191	            while chunk := await upload.read(STREAM_CHUNK_BYTES):
   192	                size += len(chunk)
   193	                digest.update(chunk)
   194	                handle.write(chunk)
   195	            if size == 0:
   196	                raise UploadValidationError(f"文件为空：{filename}")
   197	            handle.flush()
   198	            os.fsync(handle.fileno())
   199	
   200	        os.replace(temp, target)
   201	        _fsync_directory(target_dir)
   202	    except Exception:
   203	        temp.unlink(missing_ok=True)
   204	        target.unlink(missing_ok=True)
   205	        raise
   206	    finally:
   207	        await upload.close()
   208	
   209	    return StoredUpload(
   210	        stored_filename=target.relative_to(root).as_posix(),
   211	        path=target,
   212	        size_bytes=size,
   213	        checksum_sha256=digest.hexdigest(),
   214	    )
   215	
   216	
   217	def remove_stored_upload(stored: StoredUpload) -> None:
   218	    stored.path.unlink(missing_ok=True)
