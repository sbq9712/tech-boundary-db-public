   284	):
   285	    """离线部署（未配 LLM 网关）时分类失败不得拖垮本地 bge-m3 嵌入。
   286	
   287	    v7（0033 期离线交付）：分类走外部网关，嵌入是本地 canonical-qa；
   288	    两者解耦后上传资料在无网关环境仍可被问答检索，分类可事后重试。
   289	    """
   290	    from app.services import upload_ingestion
   291	
   292	    original = tmp_path / "b.txt"
   293	    original.write_text("synthetic offline text")
   294	    record = SimpleNamespace(
   295	        id=uuid.uuid4(),
   296	        stored_filename="b.txt",
   297	        original_filename="b.txt",
   298	        checksum_sha256=storage.sha256(original),
   299	        document_assets=None,
   300	        document_date=None,
   301	        classification_status="pending",
   302	        classification_attempts=0,
   303	        classification_error=None,
   304	        primary_category=None,
   305	        secondary_categories=None,
   306	        embedding_status="pending",
   307	        embedding_error=None,
   308	        chunk_count=0,
   309	        title=None,
   310	        title_source=None,
   311	        primary_section="industry",
   312	        breadth_source=None,
   313	    )
   314	    statements = []
   315	
   316	    class Session:
   317	        def execute(self, statement):
   318	            params = statement.compile().params
   319	            statements.append(params)
   320	            for key, value in params.items():
   321	                if hasattr(record, key):
   322	                    setattr(record, key, value)
   323	            return SimpleNamespace(rowcount=1)
   324	
   325	        def commit(self):
   326	            pass
   327	
   328	        def rollback(self):
   329	            pass
   330	
   331	        def close(self):
   332	            pass
   333	
   334	        def get(self, *args):
   335	            return record
   336	
   337	        def refresh(self, *args):
   338	            pass
   339	
   340	    monkeypatch.setattr(upload_ingestion, "SessionLocal", Session)
   341	    monkeypatch.setattr(upload_ingestion, "upload_root", lambda: tmp_path)
   342	    monkeypatch.setattr(runner, "ingest", lambda **kwargs: (None, "synthetic offline text", [
   343	        {"chunk_id": "c1", "text": "synthetic offline text", "metadata": {"page_number": 1}}
   344	    ]))
   345	    monkeypatch.setattr(upload_ingestion, "sync_breadth_manual_record", lambda *args: None)
   346	
   347	    def unreachable_gateway(*args, **kwargs):
   348	        raise RuntimeError("分类模型调用失败（重试 2 次后仍不可用）：ConnectError")
