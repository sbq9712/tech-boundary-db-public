    17	      TZ: Asia/Shanghai
    18	      POSTGRES_DB: ${POSTGRES_DB:-tech_intel}
    19	      POSTGRES_USER: ${POSTGRES_USER:-techdb}
    20	      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set in .env}
    21	    volumes:
    22	      - pg_data:/var/lib/postgresql/data
