   954	    except Exception as exc:
   955	        db.rollback()
   956	        message = str(exc)[:2000]
   957	        logger.warning("upload ingestion failed for %s: %s", uid, message)
   958	        try:
   959	            values = {"embedding_status": "failed", "embedding_error": message}
   960	            failed_record = db.get(UploadedFile, uid)
   961	            if classification_claimed or (failed_record and failed_record.classification_status in {"pending", "processing"}):
   962	                values.update({"classification_status": "failed", "classification_error": message})
   963	            db.execute(update(UploadedFile).where(UploadedFile.id == uid).values(**values))
   964	            db.commit()
   965	        except Exception:
   966	            db.rollback()
   967	            logger.exception("failed to persist upload ingestion error for %s", uid)
   968	        return False
   969	    finally:
   970	        db.close()
   971	
   972	
   973	def classify_uploaded_file(file_id: str | uuid.UUID) -> bool:
   974	    """Backward-compatible entry point; classification now includes embedding."""
   975	    return process_uploaded_file(file_id)

