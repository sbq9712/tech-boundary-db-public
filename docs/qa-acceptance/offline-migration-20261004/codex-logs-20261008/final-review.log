exec
/bin/bash -lc "rg -n \"def _commit_processing_result\" backend/app/services/upload_ingestion.py && nl -ba backend/app/services/upload_ingestion.py | sed -n '530,600p'; TMPDIR=/dev/shm PYTHONPATH=backend python3 - <<'PY'
from pathlib import Path
from unittest.mock import patch
import app.services.upload_ingestion as mod
import app.document_ingestion.runner as runner

class R:
    id='concurrent-id'; original_filename='a.txt'; stored_filename='a.txt'; checksum_sha256='hash'; document_assets=None; document_date=None
    classification_status='processing'; classification_attempts=1; classification_error=None; primary_category=None; secondary_categories=None
    embedding_status='pending'; embedding_attempts=1; embedding_error=None; chunk_count=0; title=None; title_source=None; primary_section='industry'; breadth_source=None

class Result:
    def scalar(self): return 0
    def first(self): return R()
class DB:
    def __init__(self): self.committed=0; self.rolled_back=0
    def execute(self,*a,**k): return Result()
    def commit(self): self.committed+=1
