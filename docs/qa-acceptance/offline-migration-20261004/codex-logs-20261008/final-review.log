   200	        "checksum_sha256": "a" * 64,
   201	        "created_at": None,
   202	        "chunks": [chunk],
   203	    }
   204	    asyncio.run(index.upsert(**arguments))
   205	    asyncio.run(index.upsert(**arguments))
   206	    restored = module.IncrementalIndex(tmp_path / "index.pkl", embed)
   207	    restored.load()
   208	    assert restored.record_count == 1
