   160	def test_vector_bm25_reload_and_delete_preserve_docling_provenance(tmp_path):
   161	    """Real canonical storage/search, deterministic embedding double, not bge-m3."""
   162	    import asyncio
   163	    import importlib.util
   164	
   165	    import numpy as np
   166	
   167	    module_path = (
   168	        Path(__file__).resolve().parents[2]
