     1	#!/bin/bash
     2	# 技术边界数据库一致性备份：PostgreSQL + 上传对象
     3	# 用法：cd /path/to/project && ./scripts/db_backup.sh
     4	set -euo pipefail
     5	
     6	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
     7	PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
     8	BACKUP_DIR="${PROJECT_DIR}/backup"
     9	KEEP_COUNT="${TECHDB_BACKUP_KEEP:-30}"
    10	TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
    11	DUMP_FILE="${BACKUP_DIR}/techdb_${TIMESTAMP}.sql.gz"
    12	UPLOAD_ARCHIVE="${BACKUP_DIR}/uploads_${TIMESTAMP}.tar.gz"
    13	QA_ARCHIVE="${BACKUP_DIR}/qa_incremental_${TIMESTAMP}.tar.gz"
    14	MANIFEST_FILE="${BACKUP_DIR}/backup_${TIMESTAMP}.sha256"
    15	DUMP_PART="${DUMP_FILE}.part"
    16	UPLOAD_PART="${UPLOAD_ARCHIVE}.part"
    17	QA_PART="${QA_ARCHIVE}.part"
    18	
    19	mkdir -p "$BACKUP_DIR"
    20	
    21	if [ -f "${PROJECT_DIR}/.env" ]; then
    22	    set -a
    23	    source "${PROJECT_DIR}/.env"
    24	    set +a
    25	fi
    26	
    27	PG_DB="${POSTGRES_DB:-tech_intel}"
    28	PG_USER="${POSTGRES_USER:-techdb}"
    29	UPLOAD_PATH="${TECHDB_UPLOAD_HOST_PATH:-./uploads}"
    30	case "$UPLOAD_PATH" in
    31	    /*) ;;
    32	    *) UPLOAD_PATH="${PROJECT_DIR}/${UPLOAD_PATH#./}" ;;
    33	esac
    34	
    35	if [ ! -d "$UPLOAD_PATH" ] || [ ! -r "$UPLOAD_PATH" ]; then
    36	    echo "[$(date)] ERROR: 上传目录不存在或不可读: ${UPLOAD_PATH}"
    37	    exit 1
    38	fi
    39	
    40	# 上传对象与 QA 增量卷均经 alpine 临时容器打包（root 属主文件宿主 tar 读不了）。
    41	if ! docker image inspect alpine:3 >/dev/null 2>&1; then
    42	    echo "[$(date)] ERROR: 缺少 alpine:3 镜像（容器打包必需）。"
    43	    echo "  在线环境: docker pull alpine:3"
    44	    echo "  离线环境: cat alpine-3.tar.gz.part-* | gunzip | docker load"
    45	    exit 1
    46	fi
    47	
    48	cleanup_parts() {
    49	    rm -f -- "$DUMP_PART" "$UPLOAD_PART" "$QA_PART"
    50	}
    51	trap cleanup_parts EXIT
    52	
    53	echo "[$(date)] 开始备份数据库 ${PG_DB} ..."
    54	if ! docker compose --project-directory "$PROJECT_DIR" exec -T db \
    55	    pg_dump -U "$PG_USER" -d "$PG_DB" --no-owner --no-acl 2>/dev/null | gzip > "$DUMP_PART"; then
    56	    echo "[$(date)] ERROR: 数据库备份失败"
    57	    exit 1
    58	fi
    59	mv -- "$DUMP_PART" "$DUMP_FILE"
    60	
    61	# 文件对象一经落盘不再修改。数据库快照先于文件归档，可保证所有 DB 引用都能进入归档。
    62	# 经 alpine 临时容器打包：uploads 子目录由容器以 root 属主写入，宿主 tar 会因
    63	# Permission denied 漏读/失败（离线交付实测踩坑）。
    64	echo "[$(date)] 开始备份上传对象 ${UPLOAD_PATH} ..."
    65	if ! docker run --rm \
    66	    -v "${UPLOAD_PATH}:/data:ro" \
    67	    -v "${BACKUP_DIR}:/backup" \
    68	    --entrypoint /bin/sh alpine:3 \
    69	    -c "cd /data && tar --exclude='./.incoming' -czf /backup/$(basename "$UPLOAD_PART") . && chmod 644 /backup/$(basename "$UPLOAD_PART")" >/dev/null; then
    70	    rm -f -- "$DUMP_FILE"
    71	    echo "[$(date)] ERROR: 上传对象备份失败，已移除不完整的数据库单份备份"
    72	    exit 1
    73	fi
    74	mv -- "$UPLOAD_PART" "$UPLOAD_ARCHIVE"
    75	
    76	# QA 增量索引卷：上传资料的 embedding/BM25 增量数据。与数据库同组备份，
    77	# 否则恢复后 embedding_status=ready 与空索引错配，已上传资料静默失去检索能力。
    78	QA_VOLUME="${TECHDB_QA_INCREMENTAL_VOLUME:-techdb_qa_incremental_0801}"
    79	echo "[$(date)] 开始备份 QA 增量索引卷 ${QA_VOLUME} ..."
    80	if docker volume inspect "$QA_VOLUME" >/dev/null 2>&1; then
    81	    # 用打入同卷挂载点的临时容器打包，保持与 docker compose 卷命名一致。
    82	    if ! docker run --rm \
    83	        -v "${QA_VOLUME}:/data:ro" \
    84	        -v "${BACKUP_DIR}:/backup" \
    85	        --entrypoint /bin/sh alpine:3 \
    86	        -c "cd /data && tar -czf /backup/$(basename "$QA_PART") . && chmod 644 /backup/$(basename "$QA_PART")" >/dev/null; then
    87	        rm -f -- "$DUMP_FILE" "$UPLOAD_ARCHIVE"
    88	        echo "[$(date)] ERROR: QA 增量索引备份失败，已移除本组其余备份"
    89	        exit 1
    90	    fi
    91	    mv -- "$QA_PART" "$QA_ARCHIVE"
    92	else
    93	    echo "[$(date)] WARNING: QA 增量索引卷 ${QA_VOLUME} 不存在，跳过该项（全新部署属正常）。"
    94	    rm -f -- "$QA_ARCHIVE"
    95	fi
    96	
    97	(
    98	    cd "$BACKUP_DIR"
    99	    if [ -f "$(basename "$QA_ARCHIVE")" ]; then
   100	        sha256sum "$(basename "$DUMP_FILE")" "$(basename "$UPLOAD_ARCHIVE")" "$(basename "$QA_ARCHIVE")" > "$(basename "$MANIFEST_FILE")"
   101	    else
   102	        sha256sum "$(basename "$DUMP_FILE")" "$(basename "$UPLOAD_ARCHIVE")" > "$(basename "$MANIFEST_FILE")"
   103	    fi
   104	)
   105	
   106	echo "[$(date)] OK: 一致性备份完成"
   107	echo "  数据库: ${DUMP_FILE}"
   108	echo "  文件对象: ${UPLOAD_ARCHIVE}"
   109	if [ -f "$QA_ARCHIVE" ]; then
   110	    echo "  QA 增量索引: ${QA_ARCHIVE}"
   111	else
   112	    echo "  QA 增量索引: 无（卷不存在，跳过）"
   113	fi
   114	echo "  校验清单: ${MANIFEST_FILE}"
   115	
   116	# 按数据库备份时间戳清理整组旧备份。
   117	mapfile -t OLD_DUMPS < <(find "$BACKUP_DIR" -maxdepth 1 -type f -name 'techdb_*.sql.gz' -printf '%T@ %p\n' | sort -nr | tail -n +$((KEEP_COUNT + 1)) | cut -d' ' -f2-)
   118	for old_dump in "${OLD_DUMPS[@]}"; do
   119	    base="$(basename "$old_dump")"
   120	    old_timestamp="${base#techdb_}"
   121	    old_timestamp="${old_timestamp%.sql.gz}"
   122	    rm -f -- \
   123	        "$old_dump" \
   124	        "${BACKUP_DIR}/uploads_${old_timestamp}.tar.gz" \
   125	        "${BACKUP_DIR}/qa_incremental_${old_timestamp}.tar.gz" \
   126	        "${BACKUP_DIR}/backup_${old_timestamp}.sha256"
   127	    echo "[$(date)] 已清理旧备份组: ${old_timestamp}"
   128	done

