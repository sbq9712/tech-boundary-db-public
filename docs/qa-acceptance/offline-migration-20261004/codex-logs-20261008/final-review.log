   187	            "section_title": "Evidence",
   188	            "provenance": [{"doc_ref": "#/texts/1", "provenance": [{"page_no": 2}]}],
   189	        },
   190	    }
   191	    index = module.IncrementalIndex(tmp_path / "index.pkl", embed)
   192	    arguments = {
   193	        "document_id": doc_id,
   194	        "filename": "a.pdf",
   195	        "title": "Evidence",
   196	        "primary_category": "未分类",
   197	        "secondary_categories": [],
