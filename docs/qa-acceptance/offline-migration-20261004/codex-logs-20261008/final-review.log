diff --git a/nginx.conf b/nginx.conf
index a09b2a8..8040546 100644
--- a/nginx.conf
+++ b/nginx.conf
@@ -2,6 +2,11 @@ server {
     listen 80;
     server_name _;
 
+    # Docker 内置 DNS（127.0.0.11）按 TTL 重解析 upstream：
+    # api 容器重启换 IP 后 nginx 不再 502（offsim A14 实证踩坑）。
+    # 变量形式的 proxy_pass 不在启动时锁定 IP，每次请求走 resolver。
+    resolver 127.0.0.11 valid=10s ipv6=off;
+
     # 上传不设大小上限：0 = 关闭 nginx 请求体限制（后端同样不限）。
     client_max_body_size 0;
 
