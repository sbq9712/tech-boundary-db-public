   978	def reconcile_upload_storage() -> None:
   979	    db = SessionLocal()
   980	    try:
   981	        records = db.scalars(
   982	            select(UploadedFile).where(UploadedFile.checksum_sha256.is_(None))
   983	        ).all()
   984	        for record in records:
   985	            try:
   986	                path = safe_upload_path(record.stored_filename)
   987	            except ValueError:
   988	                record.storage_status = "invalid_path"
   989	                continue
   990	            if not path.is_file():
   991	                record.storage_status = "missing"
   992	                continue
   993	            digest = hashlib.sha256()
   994	            with open(path, "rb") as handle:
   995	                while chunk := handle.read(STREAM_CHUNK_BYTES):
   996	                    digest.update(chunk)
   997	            record.checksum_sha256 = digest.hexdigest()
   998	            record.storage_status = "stored"
   999	        db.commit()
  1000	    finally:
  1001	        db.close()
  1002	
  1003	
  1004	def recover_pending_uploads() -> None:
  1005	    reconcile_upload_storage()
  1006	    db = SessionLocal()
  1007	    try:
  1008	        db.execute(
  1009	            update(UploadedFile)
  1010	            .where(UploadedFile.classification_status == "processing")
  1011	            .values(classification_status="pending", classification_error="服务重启后自动恢复")
  1012	        )
  1013	        db.commit()
  1014	        pending_ids = db.scalars(
  1015	            select(UploadedFile.id).where(
  1016	                (UploadedFile.classification_status == "pending")
  1017	                | (UploadedFile.embedding_status == "pending")
  1018	                | (UploadedFile.embedding_status == "processing")
  1019	            )
  1020	        ).all()
  1021	        db.execute(
  1022	            update(UploadedFile)
  1023	            .where(UploadedFile.embedding_status == "processing")
  1024	            .values(embedding_status="pending", embedding_error="服务重启后自动恢复")
  1025	        )
  1026	        db.commit()
  1027	    finally:
  1028	        db.close()
  1029	    for file_id in pending_ids:
  1030	        process_uploaded_file(file_id)
