   222	def test_incremental_index_rejects_stale_source_rev(tmp_path):
   223	    """二.2 迟到旧版本拒绝：同 record_key_sha 已有更高 source_rev 时，旧
   224	    修订号的 upsert chunk 被拒收（旧 worker 迟到副作用不覆盖新状态）；
   225	    同 rev 与无 rev 的 chunk 不受影响；去重计数随回执透出。"""
   226	    import asyncio
   227	    import importlib.util
   228	    import uuid as _uuid
   229	
   230	    import numpy as np
   231	
   232	    module_path = None
   233	    for base in Path(__file__).resolve().parents:
   234	        cand = base / "services/canonical-qa/qa-backend/incremental_index.py"
   235	        if cand.exists():
   236	            module_path = cand
   237	            break
   238	    if module_path is None:
   239	        pytest.skip("canonical-qa incremental_index.py not reachable from this layout")
   240	    spec = importlib.util.spec_from_file_location(
   241	        "stale_rev_incremental", module_path
   242	    )
   243	    module = importlib.util.module_from_spec(spec)
   244	    spec.loader.exec_module(module)
   245	
   246	    async def embed(texts):
   247	        return np.ones((len(texts), 1024), dtype=np.float32)
   248	
   249	    ksha = "ksha-stale-test"
   250	    new_doc, old_doc = str(_uuid.uuid4()), str(_uuid.uuid4())
   251	
   252	    def _chunk(doc_id, rev, text):
   253	        return {
   254	            "chunk_id": f"c-{doc_id[:8]}-{rev}",
   255	            "text": text,
   256	            "metadata": {"document_id": doc_id, "record_key_sha": ksha,
   257	                         "content_sha": f"csha-{rev}", "source_rev": rev},
   258	        }
   259	
   260	    index = module.IncrementalIndex(tmp_path / "index.pkl", embed)
   261	    base = {
   262	        "filename": "a.pdf", "title": "T", "primary_category": "未分类",
   263	        "secondary_categories": [], "confidentiality": "内部", "source_type": "其他",
   264	        "checksum_sha256": "a" * 64, "created_at": None,
   265	    }
   266	    # 先落地 rev=2（新版本）
   267	    r1 = asyncio.run(index.upsert(document_id=new_doc, chunks=[_chunk(new_doc, 2, "rev2")], **base))
   268	    assert r1["chunk_count"] == 1 and r1["rejected_stale_rev_chunks"] == 0
   269	    # 旧 worker 携带 rev=1 迟到 → 整体拒收，不落地、不覆盖
   270	    r2 = asyncio.run(index.upsert(document_id=old_doc, chunks=[_chunk(old_doc, 1, "rev1")], **base))
   271	    assert r2["rejected_stale_rev_chunks"] == 1
   272	    assert r2["status"] == "ready" and r2["chunks"] == 0  # 全拒收：无 chunk 落地
   273	    assert index.record_count == 1  # rev1 未进入索引
   274	    # 无 rev 的普通 chunk（如文件上传链）不受影响
   275	    plain = {"chunk_id": "c-plain", "text": "plain chunk",
   276	             "metadata": {"document_id": old_doc}}
   277	    r3 = asyncio.run(index.upsert(document_id=old_doc, chunks=[plain], **base))
   278	    assert r3["chunk_count"] == 1 and r3["rejected_stale_rev_chunks"] == 0
   279	    assert index.record_count == 2
