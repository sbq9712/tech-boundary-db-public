    98	@lru_cache(maxsize=1)
    99	def load_taxonomy() -> Taxonomy:
   100	    taxonomy_path, manifest_path = _project_taxonomy_paths()
   101	    try:
   102	        taxonomy_data = json.loads(taxonomy_path.read_text(encoding="utf-8"))
   103	        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
   104	    except (OSError, json.JSONDecodeError) as exc:
   105	        raise RuntimeError(f"分类目录不可用: {exc}") from exc
   106	
   107	    categories = tuple(str(item).strip() for item in taxonomy_data.get("categories", []) if str(item).strip())
   108	    result_labels = tuple(str(item).strip() for item in manifest.get("result_labels", []) if str(item).strip())
   109	    if len(categories) != int(manifest.get("output_count", 0)):
   110	        raise RuntimeError("分类目录数量与 manifest 不一致")
   111	    if set(result_labels) != RESULT_LABELS or not RESULT_LABELS.issubset(categories):
   112	        raise RuntimeError("分类目录缺少未分类/不相关处理结果")
   113	    if len(set(categories)) != len(categories):
   114	        raise RuntimeError("分类目录存在重复路径")
   115	
   116	    business_categories = tuple(item for item in categories if item not in RESULT_LABELS)
   117	    if len(business_categories) != int(manifest.get("business_category_count", 0)):
   118	        raise RuntimeError("业务分类数量与 manifest 不一致")
   119	
   120	    return Taxonomy(
   121	        taxonomy_id=str(manifest["taxonomy_id"]),
   122	        version=str(manifest["taxonomy_version"]),
   123	        categories=categories,
   124	        business_categories=business_categories,
   125	        result_labels=result_labels,
   126	    )
