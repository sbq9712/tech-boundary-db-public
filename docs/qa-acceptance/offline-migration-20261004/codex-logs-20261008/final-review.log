   229	_DOCUMENT_DATE_FORMATS: tuple[str, ...] = (
   230	    # 仅日期语义；手输带了时间也只取日期部分
   231	    ("%Y-%m-%d %H:%M:%S"),
   232	    ("%Y-%m-%d %H:%M"),
   233	    ("%Y-%m-%d"),
   234	    ("%Y-%m-%dT%H:%M:%S"),
   235	    ("%Y-%m-%dT%H:%M"),
   236	    ("%Y/%m/%d %H:%M:%S"),
   237	    ("%Y/%m/%d %H:%M"),
   238	    ("%Y/%m/%d"),
   239	    ("%Y.%m.%d %H:%M:%S"),
   240	    ("%Y.%m.%d %H:%M"),
   241	    ("%Y.%m.%d"),
   242	    ("%Y年%m月%d日 %H:%M"),
   243	    ("%Y年%m月%d日"),
   244	)
   245	
   246	
   247	def normalize_document_date(value: str | None) -> str | None:
   248	    """归一化资料日期：统一为 `YYYY-MM-DD`（仅日期，不含时间）。
   249	
   250	    接受手输的常见写法（-、/、.、年月日分隔，可带时间——只取日期部分）。
   251	    空值返回 None；无法解析或年份超出 1970-2100 抛 ValueError。
   252	    """
   253	    if value is None:
   254	        return None
   255	    text = str(value).strip()
   256	    if not text:
   257	        return None
   258	    for fmt in _DOCUMENT_DATE_FORMATS:
   259	        try:
   260	            parsed = datetime.strptime(text, fmt)
   261	        except ValueError:
   262	            continue
   263	        if not 1970 <= parsed.year <= 2100:
   264	            raise ValueError("资料日期需在 1970-2100 年之间")
   265	        return parsed.strftime("%Y-%m-%d")
   266	    raise ValueError("日期格式应为 2026-09-18（也支持 2026/09/18、2026年9月18日）")
   267	
   268	
   269	def apply_document_date(chunks: list[dict], document_date: str | None) -> list[dict]:
   270	    """把资料日期写进每个分块。
   271	
   272	    文本前缀会进入 embedding、BM25 与回答上下文——检索命中任意分块时，
   273	    模型都能看到并引用「这是几几年几月几日的资料」；元数据键供后续展示。
   274	    """
   275	    if not document_date:
   276	        return chunks
   277	    stamp = f"【资料日期：{document_date}】"
   278	    for chunk in chunks or []:
   279	        chunk["text"] = stamp + str(chunk.get("text", "") or "")
   280	        metadata = chunk.get("metadata")

