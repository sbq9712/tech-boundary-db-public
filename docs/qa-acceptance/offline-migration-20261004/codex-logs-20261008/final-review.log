    11	COPY breadth/version.txt /usr/share/nginx/html/breadth/version.txt
    12	COPY breadth/data/processed /usr/share/nginx/html/breadth/data/processed
    13	
    14	# A rebuilt web image must never silently ship without the pinned breadth runtime.
    15	# Shard count is dynamic (data volume decides); the invariant is that all three
    16	# prefix families agree and are non-zero.
    17	RUN set -eu; \
    18	    runtime=/usr/share/nginx/html/breadth/data/processed; \
    19	    for file in manifest-data.js manifest.json alert-records.json category-counts.json; do \
    20	      test -s "$runtime/$file" || { echo "Missing breadth runtime file: $file" >&2; exit 1; }; \
    21	    done; \
    22	    lite="$(find "$runtime" -type f -name 'lite-part-*.js' | wc -l | tr -d ' ')"; \
    23	    meta="$(find "$runtime" -type f -name 'meta-part-*.js' | wc -l | tr -d ' ')"; \
    24	    summary="$(find "$runtime" -type f -name 'summary-part-*.js' | wc -l | tr -d ' ')"; \
    25	    test "$lite" -gt 0 -a "$lite" -eq "$meta" -a "$meta" -eq "$summary" || \
    26	      { echo "Shard families disagree: lite=$lite meta=$meta summary=$summary" >&2; exit 1; }
    27	
    28	# Regression guard (2nd incident): a stray </div> in breadth/index.html once closed
    29	# aside.sidebar + div.layout early, pushing main.content below the fold — the whole
    30	# right side looked blank. Fail the build on div imbalance.
    31	RUN set -eu; \
