   316	    class Session:
   317	        def execute(self, statement):
   318	            params = statement.compile().params
   319	            statements.append(params)
   320	            for key, value in params.items():
   321	                if hasattr(record, key):
   322	                    setattr(record, key, value)
   323	            return SimpleNamespace(rowcount=1)
   324	
   325	        def commit(self):
   326	            pass
   327	
   328	        def rollback(self):
   329	            pass
   330	
   331	        def close(self):
   332	            pass
   333	
   334	        def get(self, *args):
   335	            return record
   336	
   337	        def refresh(self, *args):
   338	            pass
   339	
   340	    monkeypatch.setattr(upload_ingestion, "SessionLocal", Session)
   341	    monkeypatch.setattr(upload_ingestion, "upload_root", lambda: tmp_path)
   342	    monkeypatch.setattr(runner, "ingest", lambda **kwargs: (None, "synthetic offline text", [
   343	        {"chunk_id": "c1", "text": "synthetic offline text", "metadata": {"page_number": 1}}
   344	    ]))
   345	    monkeypatch.setattr(upload_ingestion, "sync_breadth_manual_record", lambda *args: None)
   346	
   347	    def unreachable_gateway(*args, **kwargs):
   348	        raise RuntimeError("分类模型调用失败（重试 2 次后仍不可用）：ConnectError")
   349	
   350	    monkeypatch.setattr(upload_ingestion, "request_ai_classification", unreachable_gateway)
   351	    monkeypatch.setattr(
   352	        upload_ingestion,
   353	        "request_incremental_index",
   354	        lambda rec, data: {"status": "ready", "chunk_count": len(data)},
   355	    )
   356	    assert upload_ingestion.process_uploaded_file(record.id) is True
   357	    assert record.embedding_status == "ready"
   358	    assert record.chunk_count == 1
   359	    assert record.classification_status == "failed"
   360	    assert "仍不可用" in (record.classification_error or "")

