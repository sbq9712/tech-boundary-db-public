   742	@router.post("/uploads/{file_id}/embedding/retry", status_code=202)
   743	def retry_upload_embedding(
   744	    file_id: str,
   745	    background_tasks: BackgroundTasks,
   746	    current_user: str = Depends(require_admin),
   747	    db: Session = Depends(get_db),
   748	) -> dict:
   749	    record = db.get(UploadedFile, _uuid_or_400(file_id))
   750	    if record is None:
   751	        raise HTTPException(404, "文件不存在")
   752	    if record.storage_status != "stored":
   753	        raise HTTPException(409, "文件未正常落盘，不能重试 embedding")
   754	    terminal = {"classified", "unclassified", "irrelevant", "legacy_unclassified"}
   755	    if record.classification_status not in terminal:
   756	        raise HTTPException(409, "请先完成文件分类")
   757	    if record.embedding_status in {"pending", "processing"}:
   758	        return {"id": str(record.id), "embedding_status": record.embedding_status}
   759	    # 增量包/逐行表格导入：索引走持久队列，重试 = 失败任务重新入队；
   760	    # 旧导入（队列启用前，状态 skipped 且从无任务）首次补建全部行的任务
   761	    has_tasks = db.scalar(select(IndexTask.id).where(IndexTask.upload_id == record.id)) is not None
   762	    is_zip_import = record.primary_section == "breadth" and record.breadth_source == "github"
   763	    if has_tasks or (is_zip_import and record.embedding_status in {"queued", "skipped"}):
   764	        from app.models.breadth_manual_record import BreadthManualRecord
   765	        from app.services.breadth_index_queue import enqueue_record_upserts, process_batch
   766	
   767	        tasks = db.scalars(select(IndexTask).where(IndexTask.upload_id == record.id)).all()
   768	        rows = db.scalars(
   769	            select(BreadthManualRecord).where(BreadthManualRecord.upload_id == record.id)
   770	        ).all()
   771	        if not rows and not tasks and record.stored_filename:
   772	            # 任务一 1.2 恢复缺口：zip 已落盘但导入从未完成（无会话/无记录/
   773	            # 无任务，legacy_unknown）——重试 = 从存储对象重新导入（幂等：
   774	            # 包内记录与既有身份/墓碑按既有规则合并，重复执行无副作用）
   775	            from app.services.upload_ingestion import safe_upload_path as _safe_path
   776	
   777	            zip_path = _safe_path(record.stored_filename)
   778	            if not zip_path.exists():
   779	                raise HTTPException(409, "增量包存储对象缺失，无法重新导入；请删除后重新上传")
   780	            try:
   781	                payload = import_github_package(db, record, zip_path)
   782	                record.title = f"广度增量包 {payload['package_date']}"
   783	                record.document_date = payload["package_date"]
   784	                record.note = note_for_counts(payload)
   785	            except GitHubPackageError as exc:
   786	                # 包不合规：导入器已回滚自身写入，这里兜底清理会话状态后 400
   787	                db.rollback()
   788	                raise HTTPException(400, f"增量包不合规：{exc}") from exc
   789	            except ValueError as exc:
   790	                # 存储路径越界/内容结构异常：会话可能带部分已提交状态
   791	                db.rollback()
   792	                raise HTTPException(409, f"增量包存储或内容异常：{exc}") from exc
   793	            except Exception as exc:  # noqa: BLE001 —— Codex P1-6：IO/解析等意外
   794	                db.rollback()
   795	                logger.error("retry reimport failed for %s", record.id, exc_info=True)
   796	                raise HTTPException(
   797	                    503, "重新导入暂不可用（存储/解析异常），请稍后重试") from exc
   798	            # 注意：不 refresh——上面 title/document_date/note 尚未落库，
   799	            # refresh 会丢弃未 flush 的赋值
   800	            new_rows = db.scalars(
   801	                select(BreadthManualRecord).where(BreadthManualRecord.upload_id == record.id)
   802	            ).all()
   803	            if new_rows:
   804	                enqueue_record_upserts(db, new_rows)
   805	            record.embedding_status = "queued" if new_rows else "skipped"
   806	            record.embedding_error = None
   807	            db.commit()
   808	            background_tasks.add_task(process_batch)
   809	            return {"id": str(record.id), "embedding_status": record.embedding_status}
   810	        if rows:
   811	            # 重试 = 真实恢复动作（drill 重启/损坏恢复发现）：行记录一律重入队。
   812	            # 旧行为只重置 failed/pending 任务——任务全 done 但索引内容丢失
   813	            # （损坏清空/重放缺失）时重试是 no-op，用户按钮无效。
   814	            # upsert 幂等（同内容指纹 canonical 侧去重），健康状态下重试只是浪费，
   815	            # 而 UI 只在异常态给重试按钮。
   816	            enqueue_record_upserts(db, rows)
   817	        for task in tasks:
   818	            if task.status in ("failed", "pending"):
   819	                task.status = "pending"
   820	                task.attempts = 0
   821	                task.not_before = None
   822	                task.last_error = None
   823	        record.embedding_status = "queued"
   824	        record.embedding_error = None
   825	        db.commit()
   826	        background_tasks.add_task(process_batch)
   827	        return {"id": str(record.id), "embedding_status": "queued"}
   828	    record.embedding_status = "pending"
   829	    record.embedding_error = None
   830	    record.embedded_at = None
   831	    record.chunk_count = 0
   832	    db.commit()
   833	    background_tasks.add_task(process_uploaded_file, str(record.id))
   834	    return {"id": str(record.id), "embedding_status": "pending"}
