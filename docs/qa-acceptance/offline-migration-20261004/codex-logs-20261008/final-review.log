    33	    opens="$(grep -o '<div\b' "$page" | wc -l | tr -d ' ')"; \
    34	    closes="$(grep -o '</div>' "$page" | wc -l | tr -d ' ')"; \
    35	    test "$opens" -eq "$closes" || \
