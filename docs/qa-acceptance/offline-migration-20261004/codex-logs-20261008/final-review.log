   571	def request_incremental_index(record: UploadedFile, chunks: list[dict]) -> dict:
   572	    """Send Docling semantic chunks without re-chunking or losing provenance."""
   573	    if not chunks:
   574	        return {"chunk_count": 0, "status": "skipped"}
   575	    base_url = os.getenv("TECHDB_QA_SERVICE_URL", "").strip().rstrip("/")
   576	    if not base_url:
   577	        raise RuntimeError("TECHDB_QA_SERVICE_URL 未配置，无法写入增量索引")
   578	    timeout = float(os.getenv("TECHDB_QA_INDEX_TIMEOUT_SECONDS", "300"))
   579	    token = os.getenv("TECHDB_QA_INDEX_TOKEN", "").strip()
   580	    # 任务二 2.1：Docling 上传链的 chunk metadata 注入原始栏目归属——
   581	    # 此前该链不传栏目，增量记录在检索/引用/图谱侧无法分域。只补 metadata
   582	    # 键，不动 chunk 正文/分块（chunks.jsonl 落盘内容不变）。
   583	    section = (getattr(record, "primary_section", None) or "breadth").strip().lower()
   584	    if section not in ("breadth", "industry", "atsc"):
   585	        section = "breadth"
   586	    section_source = {"breadth": "breadth-import", "industry": "industry-import",
   587	                      "atsc": "atsc-import"}[section]
   588	    for chunk in chunks:
   589	        meta = chunk.get("metadata")
   590	        if isinstance(meta, dict):
   591	            meta.setdefault("primary_section", section)
   592	            meta.setdefault("source", section_source)
   593	    payload = {
   594	        "document_id": str(record.id),
   595	        "filename": record.original_filename,
   596	        "title": record.title or record.original_filename,
   597	        "primary_category": record.primary_category or "未分类",
   598	        "secondary_categories": record.secondary_categories or [],
   599	        # v7（0023）契约：上传链负载不携带 source_type——归属走 chunk
   600	        # metadata.primary_section/source（上面的注入）。
   601	        "checksum_sha256": record.checksum_sha256,
   602	        "created_at": record.created_at.isoformat() if record.created_at else None,
   603	        "chunks": chunks,
   604	    }
   605	    headers = {"X-TechDB-Index-Token": token} if token else {}
   606	    with httpx.Client(timeout=timeout) as client:
   607	        response = client.post(f"{base_url}/api/index/upsert", headers=headers, json=payload)
   608	        response.raise_for_status()
   609	        result = response.json()
   610	    if result.get("status") != "ready":
   611	        raise RuntimeError("canonical-qa 未确认增量索引已写入")
   612	    return result
