   640	    db: Session = Depends(get_db),
   641	) -> dict:
   642	    """按分区过滤；同时返回各分区计数（counts/counts_breadth），供资料库导航展示。"""
   643	    filters = []
   644	    if section:
   645	        if section not in PRIMARY_SECTIONS:
   646	            raise HTTPException(400, "一级分区只能是：breadth / industry / atsc")
   647	        filters.append(UploadedFile.primary_section == section)
   648	        # 广度二级：请求具体来源时精确过滤；未指明来源时返回该一级分区全部
   649	        if breadth_source:
   650	            if breadth_source not in BREADTH_SOURCES:
   651	                raise HTTPException(400, "广度来源只能是：github / other")
   652	            filters.append(UploadedFile.breadth_source == breadth_source)
   653	    if primary_category:
   654	        filters.append(UploadedFile.primary_category == primary_category)
   655	    if classification_status:
   656	        filters.append(UploadedFile.classification_status == classification_status)
   657	
   658	    query = select(UploadedFile).where(*filters).order_by(UploadedFile.created_at.desc())
   659	    count_query = select(func.count()).select_from(UploadedFile).where(*filters)
   660	    rows = db.scalars(query.limit(max(1, min(limit, 500))).offset(max(0, offset))).all()
   661	    # 各分区计数（不受当前过滤影响，供导航角标/计数展示）
   662	    section_counts = dict(
   663	        db.execute(
   664	            select(UploadedFile.primary_section, func.count()).group_by(UploadedFile.primary_section)
   665	        ).all()
   666	    )
   667	    breadth_counts = dict(
   668	        db.execute(
   669	            select(UploadedFile.breadth_source, func.count())
   670	            .where(UploadedFile.primary_section == "breadth")
   671	            .group_by(UploadedFile.breadth_source)
   672	        ).all()
   673	    )
   674	    # 任务一 1.1：队列驱动上传（GitHub 增量包 + 逐行表格）的真实状态映射
   675	    # （单条 GROUP BY，无 N+1）+ 会话计数（仅 GitHub 包有会话）
   676	    github_rows = [r for r in rows if r.primary_section == "breadth" and r.breadth_source == "github"]
   677	    github_ids = [r.id for r in github_rows]
   678	    tasks_agg = queue_aggregate(db, [r.id for r in rows])
   679	    sess_map = sessions_map(db, github_ids)
   680	    live_counts: dict = {}
   681	    if rows:
   682	        from app.models.breadth_manual_record import BreadthManualRecord as _BMR
   683	        for uid, cnt in db.execute(
   684	            select(_BMR.upload_id, func.count())
   685	            .where(_BMR.upload_id.in_([r.id for r in rows]))
   686	            .group_by(_BMR.upload_id)
   687	        ).all():
   688	            if uid is not None:
   689	                live_counts[uid] = int(cnt)
   690	    index_details: dict = {}
   691	    for r in rows:
   692	        tasks = tasks_agg.get(r.id, {})
   693	        # GitHub 分支始终映射（legacy_unknown 也要显式暴露）；
   694	        # 其余分支仅有队列任务时映射——Docling 链走既有状态链
   695	        is_github_row = r.primary_section == "breadth" and r.breadth_source == "github"
   696	        if not is_github_row and not tasks:
   697	            continue
   698	        status, detail = map_github_status(
   699	            r, tasks, sess_map.get(r.id), live_counts.get(r.id))
   700	        detail["status"] = status
   701	        index_details[r.id] = detail
   702	    return {
   703	        "count": db.scalar(count_query) or 0,
   704	        "files": [
   705	            _serialize(row, index_details.get(row.id)) for row in rows
   706	        ],
   707	        "counts": {
   708	            "breadth": section_counts.get("breadth", 0),
   709	            "industry": section_counts.get("industry", 0),
   710	            "atsc": section_counts.get("atsc", 0),
   711	            "github": breadth_counts.get("github", 0),
   712	            "other": breadth_counts.get("other", 0),
   713	        },
   714	    }
