--- CONTRACT ---
     1	"""Deployment contract tests for the integrated BoundaryDB stack.
     2	
     3	These are intentionally text-level tests: they catch the class of regression where
     4	new QA/upload code exists in the repository but normal deployment silently starts an
     5	old pre-migration image or builds a canonical-qa image without the migrated modules.
     6	"""
     7	from pathlib import Path
     8	
     9	ROOT = Path(__file__).resolve().parents[2]
    10	
    11	
    12	def test_compose_defaults_to_integrated_service_images():
    13	    compose = (ROOT / "docker-compose.yml").read_text(encoding="utf-8")
    14	    # 离线交付集 server-20261004：qa=1008（含 TECHDB_QA_LLM_BASE_URL 空串回落）、
    15	    # api=agent=1018（6307112）、web=1016。默认值必须指向已验收 tag，杜绝静默回退旧镜像。
    16	    assert "techdb-canonical-qa:${TECHDB_QA_IMAGE_TAG:-1008}" in compose
    17	    assert "techdb-api:${TECHDB_API_IMAGE_TAG:-1019}" in compose
    18	    assert "techdb-readonly-agent:${TECHDB_AGENT_IMAGE_TAG:-1019}" in compose
    19	    assert "techdb-web:${TECHDB_WEB_IMAGE_TAG:-1017}" in compose
    20	    assert "TECHDB_QA_IMAGE_TAG:-0801" not in compose
    21	    assert "TECHDB_API_IMAGE_TAG:-0801" not in compose
    22	    for stale in ("TECHDB_QA_IMAGE_TAG:-1001", "TECHDB_API_IMAGE_TAG:-1001",
    23	                  "TECHDB_AGENT_IMAGE_TAG:-1001", "TECHDB_WEB_IMAGE_TAG:-1001"):
    24	        assert stale not in compose
    25	
    26	
    27	def test_deploy_script_honors_per_service_tags():
    28	    deploy = (ROOT / "deploy.sh").read_text(encoding="utf-8")
    29	    for name in (
    30	        "TECHDB_QA_IMAGE_TAG",
    31	        "TECHDB_API_IMAGE_TAG",
    32	        "TECHDB_AGENT_IMAGE_TAG",
    33	        "TECHDB_WEB_IMAGE_TAG",
    34	    ):
    35	        assert name in deploy
    36	    assert "techdb-canonical-qa:0801" not in deploy
    37	    assert 'APP_IMAGES=("techdb-api:0801"' not in deploy
    38	    for name, tag in (
    39	        ("TECHDB_QA_IMAGE_TAG", "1008"),
    40	        ("TECHDB_API_IMAGE_TAG", "1019"),
    41	        ("TECHDB_AGENT_IMAGE_TAG", "1019"),
    42	        ("TECHDB_WEB_IMAGE_TAG", "1017"),
    43	    ):
    44	        assert f"{name}:-{tag}}}\"" in deploy
    45	
    46	
    47	def test_deploy_script_asserts_incremental_index_ready():
    48	    # canonical-qa 就绪断言必须覆盖增量索引（uploads 增量融合链路），否则
    49	    # 恢复后 incremental 索引缺失时 deploy.sh 仍报成功。
    50	    deploy = (ROOT / "deploy.sh").read_text(encoding="utf-8")
    51	    assert "incremental_index_ready" in deploy
    52	    assert "incremental_corrupt" in deploy
    53	
    54	
    55	def test_db_backup_packs_uploads_via_container():
    56	    # uploads 子目录由容器以 root 属主写入，宿主 tar 会 Permission denied；
    57	    # 必须经 alpine 临时容器打包（离线交付实测踩坑）。
    58	    backup = (ROOT / "scripts" / "db_backup.sh").read_text(encoding="utf-8")
    59	    assert "alpine:3" in backup
    60	    assert '-v "${UPLOAD_PATH}:/data:ro"' in backup
    61	    host_tar = 'tar --exclude=\'./.incoming\' -C "$UPLOAD_PATH"'
    62	    assert host_tar not in backup
    63	
    64	
    65	def test_nginx_re_resolves_api_upstream_after_container_restart():
    66	    # Docker 内 nginx 启动时解析 upstream 域名并缓存 IP；api 容器重启换 IP 后
    67	    # 旧缓存导致 /api/ 全量 502（offsim A14 重启演练实证）。必须用
    68	    # resolver+变量 proxy_pass 强制按 TTL 重解析。
    69	    conf = (ROOT / "nginx.conf").read_text(encoding="utf-8")
    70	    assert "resolver 127.0.0.11" in conf
    71	    assert "set $api_upstream" in conf and "set $qa_upstream" in conf
    72	    assert "proxy_pass $api_upstream;" in conf and "proxy_pass $qa_upstream;" in conf
    73	
    74	
    75	def test_deploy_missing_image_hint_points_to_release():
    76	    deploy = (ROOT / "deploy.sh").read_text(encoding="utf-8")
    77	    assert "docker-images 分支" not in deploy
    78	    assert "server-20261004" in deploy
    79	
    80	
    81	def test_release_image_contains_full_migrated_qa_chain():
    82	    dockerfile = (
    83	        ROOT / "services" / "canonical-qa" / "qa-backend" / "Dockerfile.release"
    84	    ).read_text(encoding="utf-8")
    85	    required_modules = (
    86	        "record_ops.py",
    87	        "graph_fragment.py",
    88	        "answer_chain.py",
    89	        "epistemic.py",
    90	        "verifier.py",
    91	        "claim_mapping.py",
    92	        "citation_grounding.py",
    93	        "numeric_facts.py",
    94	        "primary_evidence.py",
    95	        "answer_status.py",
    96	        "knowledge_boundary.py",
    97	        "answer_repair.py",
    98	        "provenance.py",
    99	        "evidence_metadata.py",
   100	        "runtime_safety.py",
   101	    )
   102	    for module in required_modules:
   103	        assert module in dockerfile
   104	
   105	
   106	def test_nginx_long_timeout_scoped_to_sse_only():
   107	    """SSE 专属长超时（2026-10-03 network error 修复 + Codex P3 收窄）。
   108	
   109	    1800s 只允许出现在流式端点的 location 块内；普通 /api/ 维持 300s，
   110	    防止心跳机制把真实卡死的普通请求无差别续命。
   111	    """
   112	    import re
   113	
   114	    conf = (ROOT / "nginx.conf").read_text(encoding="utf-8")
   115	    blocks = re.findall(
   116	        r"location\s+([^\{]+)\{([^{}]*)\}", conf, flags=re.S
   117	    )
   118	    assert blocks, "nginx.conf 应至少包含一个 location 块"
   119	    seen_sse = False
   120	    for header, body in blocks:
   121	        header = header.strip()
   122	        if re.search(r"/api/\(assistant/stream\|breadth/qa/chat/stream\)", header):
   123	            seen_sse = True
   124	            assert "proxy_read_timeout 1800s" in body, header
   125	            assert "proxy_send_timeout 1800s" in body, header
   126	            assert "proxy_buffering off" in body, header
   127	        elif header == "/api/":
   128	            assert "proxy_read_timeout 300s" in body, header
   129	            assert "proxy_read_timeout 1800s" not in body, header
   130	    assert seen_sse, "SSE 端点应有独立 location 承载 1800s 超时"

