     1	networks:
     2	  technet:
     3	    driver: bridge
     4	    # WSL host eth0 MTU is 1410, but Docker default bridge is 1500.
     5	    # Oversized TLS ClientHello packets get silently dropped at the WSL NAT,
     6	    # causing SSL UNEXPECTED_EOF errors to external AI APIs.
     7	    # Match the network MTU to the host to fix this.
     8	    driver_opts:
     9	      com.docker.network.driver.mtu: ${TECHDB_DOCKER_MTU:-1410}
    10	
    11	services:
    12	  db:
    13	    image: postgres:16
