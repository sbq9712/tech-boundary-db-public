*.tgz

# Database backups
backup/

# Generated screenshots and reports
screenshots/
reports/

# External support data. Keep README files as contracts; hydrate locally via scripts.
external-data/*
!external-data/README.md
!external-data/knowledge-base/
!external-data/delivery-views/
!external-data/chatbot-package/
!external-data/qa-assets/
external-data/knowledge-base/*
external-data/delivery-views/*
external-data/chatbot-package/*
external-data/qa-assets/*
!external-data/knowledge-base/.gitkeep
!external-data/delivery-views/.gitkeep
!external-data/chatbot-package/.gitkeep
!external-data/qa-assets/README.md

# Large raw/index data remains outside Git.
data_sources/tech_kb_builder_2025w41/indexes/
data_sources/tech_kb_builder_2025w41/quality_reports/
data_sources/tech_kb_builder_2025w41/rag/

# Canonical QA release assets are delivered inside the docker-images tar only.
services/canonical-qa/bge-m3-model/
services/canonical-qa/data/lightrag/*.pkl
services/canonical-qa/data/lightrag/graph-export.json
services/canonical-qa/data/lightrag/jieba_custom_dict.txt
services/canonical-qa/data/processed/all-records-lite.json

# Breadth-tracking generated data (shards + knowledge index). Downloaded from upstream.
breadth/data/processed/*
!breadth/data/processed/README.md
!breadth/data/processed/.gitkeep
breadth/data/knowledge/*
!breadth/data/knowledge/.gitkeep

# 广度报告（独立管线生成，不入 Git）
breadth/data/reports/
# 独立广度管线的运行时存储与虚拟环境（配置类 JSON/JS 除外）
pipeline/data/processed/
pipeline/data/csv_cache/
pipeline/data/reports/
pipeline/data/*.db
pipeline/models/
pipeline/.venv/
