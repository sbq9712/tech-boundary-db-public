# External support data. Keep README files as contracts; hydrate locally via scripts.
external-data/*
!external-data/README.md
!external-data/knowledge-base/
!external-data/delivery-views/
!external-data/chatbot-package/
external-data/knowledge-base/*
external-data/delivery-views/*
external-data/chatbot-package/*
!external-data/knowledge-base/.gitkeep
!external-data/delivery-views/.gitkeep
!external-data/chatbot-package/.gitkeep

